# Первый запуск работает без токена, данные вымышленные.
DATA_MODE=demo
# ID собственного Web-приложения из кабинета VK ID.
VK_APP_ID=
# Сервисный ключ можно ввести в интерфейсе; здесь оставьте пустым.
VK_SERVICE_TOKEN=
# Необязательный старый пользовательский токен вместо входа через VK ID.
VK_TOKEN=
VK_API_VERSION=5.199

# Только локальная разработка. Для URL используйте буквы/цифры/подчёркивания.
POSTGRES_PASSWORD=audience_local

# Ограничения выборки — не общий размер аудитории VK.
MAX_GROUPS=3
MAX_MEMBERS_PER_GROUP=500
MAX_POSTS=10
MAX_REACTIONS_PER_POST=200
MAX_USERS=3000
MAX_CITY_LOOKUPS=20
POST_SEARCH_DAYS=30
